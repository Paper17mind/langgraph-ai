import os
import json
import importlib
import inspect
from typing import TypedDict, Annotated, Any, Optional

from dotenv import load_dotenv
load_dotenv()

from langchain_openai import ChatOpenAI
from langchain_groq import ChatGroq
from langchain_core.messages import SystemMessage, BaseMessage, ToolMessage
from langchain_core.tools import BaseTool

from langgraph.graph import StateGraph, START, END
from langgraph.graph.message import add_messages
from core.logger import log_internal_step
from langchain_core.callbacks import BaseCallbackHandler

def load_all_tools():
    dynamic_tools = []
    base_skills_dir = os.path.join(os.path.dirname(os.path.dirname(__file__)), "skills")
    generated_skills_dir = os.path.join(base_skills_dir, "generated")
    
    dirs_to_scan = [
        (base_skills_dir, "skills"),
        (generated_skills_dir, "skills.generated")
    ]
    
    for directory, module_prefix in dirs_to_scan:
        if not os.path.exists(directory):
            continue
            
        for filename in os.listdir(directory):
            if filename.endswith("_skill.py") and not filename.startswith("__"):
                module_name = f"{module_prefix}.{filename[:-3]}"
                try:
                    module = importlib.import_module(module_name)
                    # Force reload to pick up new changes if generated autonomously
                    importlib.reload(module)
                    for name, obj in inspect.getmembers(module):
                        if isinstance(obj, BaseTool):
                            if obj.name not in [t.name for t in dynamic_tools]:
                                dynamic_tools.append(obj)
                except Exception as e:
                    print(f"Warning: Failed to load {module_name}: {e}")
                    
    return dynamic_tools

def init_llm():
    ninerouter_key = os.getenv("9ROUTER_API_KEY", "")
    ninerouter_url = os.getenv("9ROUTER_URL", "https://9router.com/api/v1/chat/completions")
    base_url = ninerouter_url.replace("/chat/completions", "")
    ninerouter_model = os.getenv("9ROUTER_MODEL", "google/gemini-pro")
    groq_key = os.getenv("GROQ_API_KEY", "")

    if ninerouter_key:
        llm = ChatOpenAI(
            api_key=ninerouter_key,
            base_url=base_url,
            model=ninerouter_model,
            temperature=0.4,
            timeout=30,
            max_retries=1
        )
        if groq_key:
            groq_llm = ChatGroq(
                api_key=groq_key,
                model_name="llama-3.3-70b-versatile",
                temperature=0.4,
                timeout=30,
                max_retries=1
            )
            llm = llm.with_fallbacks([groq_llm])
        return llm

    if groq_key:
        return ChatGroq(
            api_key=groq_key,
            model_name="llama-3.3-70b-versatile",
            temperature=0.4,
            timeout=30,
            max_retries=1
        )

    raise ValueError("No LLM API keys configured (9ROUTER_API_KEY or GROQ_API_KEY).")

SYSTEM_PROMPT = """You are a highly capable AI assistant running on the user's desktop.
You have access to several tools. Use them to help the user.
Kamu memiliki memori jangka panjang (Buku Catatan). Simpanlah informasi penting secara otomatis menggunakan tool 'remember_fact', termasuk: fakta personal user, konteks/arsitektur project, dependensi yang digunakan, dan terutama KESALAHAN/BUG dari kodemu sebelumnya agar tidak diulangi.
Jika kamu menghadapi masalah coding atau butuh konteks, gunakan tool 'recall_facts' untuk mencari solusi masa lalumu.
Jika kamu diminta melakukan sesuatu dan kamu tidak punya tool yang sesuai, panggillah nama tool tersebut. Sistem ini memiliki Cognitive OS yang akan secara OTOMATIS menuliskan kode Python untuk tool tersebut (Fully Autonomous Coder Skill), memuatnya, dan meminta kamu mengulang kembali panggilanmu!
PENTING:
1. Selalu simpan file kode/script baru HANYA di folder `skills/generated/`. DILARANG KERAS membuat file python di folder root (`/`).
2. Jangan membuat script sekali pakai. Buatlah tool dengan decorator `@tool` yang DINAMIS (reusable) dengan parameter/argumen.
3. Jika kamu butuh membuat file temporary atau script cakar-cakaran untuk testing (seperti melalui terminal bash `cat << EOF`), kamu WAJIB menyimpannya di dalam folder `scratch/` (buat foldernya jika belum ada). DILARANG KERAS menaruh file temporary di folder root!
4. ANTI-DUPLIKASI PROYEK: SEBELUM membuat folder proyek baru, kamu WAJIB mengecek daftar folder yang sudah ada di dalam direktori `projects/`. Gunakan folder yang sudah ada jika proyeknya sama. Setelah membuat proyek baru, WAJIB menyimpannya ke memori jangka panjang menggunakan tool 'remember_fact'.
If a tool returns an error, read the error carefully and try again to fix the problem.
PENTING (Efisiensi Token): Jika kamu membutuhkan beberapa data sekaligus, panggillah beberapa tool secara BERSAMAAN (Parallel Tool Calling) dalam satu kali respons.
Do not stop until you have either succeeded or fundamentally cannot proceed.
PENTING: Gunakan bahasa Indonesia yang SANGAT SANTAI, ramah, dan luwes layaknya sedang ngobrol dengan teman (contoh: pakai kata 'aku', 'kamu', 'nih', 'yuk'). JANGAN PERNAH memberikan jawaban berupa poin-poin kaku tanpa basa-basi. Bumbui setiap responmu dengan interaksi manusiawi dan asyik!"""

class AgentLoggingCallback(BaseCallbackHandler):
    def on_chat_model_end(self, response, **kwargs):
        try:
            message = response.generations[0][0].message
            content = message.content
            tool_calls = getattr(message, "tool_calls", [])
            log_internal_step("llm_response", {"content": content, "tool_calls": tool_calls})
        except Exception:
            pass

    def on_tool_start(self, serialized, input_str, **kwargs):
        try:
            tool_name = serialized.get("name", "unknown")
            args = json.loads(input_str) if isinstance(input_str, str) else input_str
            log_internal_step("tool_start", {"tool_name": tool_name, "args": args})
        except:
            pass

    def on_tool_end(self, output, **kwargs):
        try:
            log_internal_step("tool_end", {"output": str(output)[:1000]})
        except:
            pass

global_callbacks = [AgentLoggingCallback()]

class AgentState(TypedDict):
    messages: Annotated[list[BaseMessage], add_messages]
    active_project: Optional[str]
    context_query: str
    memories: str
    project_context: str
    available_tools: list[Any]
    system_prompt: str

def get_agent_executor(active_project: str = None):
    def context_builder(state: AgentState):
        last_msg = state["messages"][-1].content if hasattr(state["messages"][-1], "content") else ""
        return {"context_query": last_msg, "active_project": active_project}

    def memory_retriever(state: AgentState):
        import sys
        sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
        from utils.memory_db import memory_db
        query = state.get("context_query", "")
        if query:
            facts = memory_db.search_facts(query, k=3)
        else:
            facts = "Tidak ada kueri spesifik."
        return {"memories": facts}

    def tool_search_retriever(state: AgentState):
        # PERBAIKAN KECEPATAN: Bypass pemanggilan LLM ekstra untuk memfilter tool.
        # Kita langsung meload semua tool agar kecepatannya kembali instan seperti agen sebelumnya.
        all_tools = load_all_tools()
        return {"available_tools": all_tools}

    def project_search(state: AgentState):
        proj = state.get("active_project")
        if not proj:
            return {"project_context": "Tidak ada proyek aktif yang disetel user."}
        
        proj_dir = os.path.join(os.path.dirname(os.path.dirname(__file__)), "projects", proj)
        if not os.path.exists(proj_dir):
            return {"project_context": f"Proyek {proj} aktif, tetapi folder projects/{proj} belum dibuat."}
            
        try:
            files = []
            for root, dirs, filenames in os.walk(proj_dir):
                for f in filenames:
                    if "node_modules" in root or "__pycache__" in root or ".git" in root:
                        continue
                    files.append(os.path.relpath(os.path.join(root, f), proj_dir))
            context = f"Struktur file proyek {proj}:\n" + "\n".join(files[:50])
            if len(files) > 50:
                context += "\n... (dan file lainnya)"
            return {"project_context": context}
        except Exception as e:
            return {"project_context": f"Gagal membaca direktori proyek: {e}"}

    def prompt_builder(state: AgentState):
        import datetime
        current_time_str = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        final_prompt = SYSTEM_PROMPT + f"\n\n[INFO SISTEM]\nWaktu server saat ini adalah: {current_time_str}\n"
        
        if state.get("memories"):
            final_prompt += f"\n\n[INGATAN MASA LALU (ChromaDB)]\n{state['memories']}\n"
            
        proj = state.get("active_project")
        if proj:
            final_prompt += f"\n\n[KONTEKS PROYEK AKTIF]\nKamu sedang bekerja pada proyek: {proj}\n"
            final_prompt += f"Semua file/kode untuk proyek ini WAJIB diletakkan di dalam folder `projects/{proj}/`.\n"
            final_prompt += f"{state.get('project_context', '')}\n\n"
            
            final_prompt += """[CODING GUIDELINES & ARCHITECTURE & WORKFLOW]
Sebagai Fullstack Engineer profesional untuk proyek ini, patuhi aturan alur kerja (workflow) berikut:
1. MATANGKAN FSD DULU: Jangan menulis kode aplikasi apapun sebelum FSD benar-benar matang dan disetujui.
2. BUAT TASK LOKAL: Buat task-task terstruktur dan catat ke dalam file `tasks.md`.
3. EKSEKUSI TERSTRUKTUR: Kerjakan coding berdasarkan task di `tasks.md`.
4. ATURAN TEKNIS (BACKEND): Wajib mengaktifkan `CORSMiddleware`. Kembalikan data dalam format JSON terstruktur.
5. ATURAN TEKNIS (FRONTEND): UI WAJIB menggunakan TailwindCSS CDN dengan desain yang SANGAT PREMIUM.
6. SINKRONISASI DATA: Pastikan struktur data JSON Backend SAMA PERSIS dengan Frontend.
7. UNIT TESTING WAJIB: Buatkan Unit Test (pytest/unittest) untuk backend.
8. DOKUMENTASI BUG & ERROR: Gunakan tool `remember_fact` untuk mencatat bug & solusi.
9. CEK PEDOMAN LOKAL: Gunakan tool `list_guidelines` & `read_guideline`.
"""
        return {"system_prompt": final_prompt}

    def react_llm(state: AgentState):
        llm = init_llm()
        tools = state.get("available_tools", [])
        if tools:
            # Prevent hallucinated tools from breaking the bind if necessary
            # We bind dynamically loaded tools
            llm = llm.bind_tools(tools)
            
        sys_msg = SystemMessage(content=state.get("system_prompt", SYSTEM_PROMPT))
        filtered_msgs = [m for m in state["messages"] if not isinstance(m, SystemMessage)]
        
        response = llm.invoke([sys_msg] + filtered_msgs, config={"callbacks": global_callbacks})
        return {"messages": [response]}

    def route_after_llm(state: AgentState) -> str:
        last_msg = state["messages"][-1]
        if not hasattr(last_msg, "tool_calls") or not last_msg.tool_calls:
            return "END"
            
        available_names = [t.name for t in state.get("available_tools", [])]
        for tc in last_msg.tool_calls:
            if tc["name"] not in available_names:
                print(f"[COGNITIVE OS] Detected missing tool: {tc['name']}. Triggering Autonomous Coder Skill...")
                return "coder_skill"
                
        return "execute_tool"

    def execute_tool(state: AgentState):
        last_msg = state["messages"][-1]
        tools_map = {t.name: t for t in state.get("available_tools", [])}
        
        results = []
        for tc in last_msg.tool_calls:
            tool_name = tc["name"]
            tool_args = tc.get("args", {})
            if tool_name in tools_map:
                try:
                    tool_res = tools_map[tool_name].invoke(tool_args)
                    results.append(ToolMessage(tool_call_id=tc["id"], name=tool_name, content=str(tool_res)))
                except Exception as e:
                    results.append(ToolMessage(tool_call_id=tc["id"], name=tool_name, content=f"Error executing {tool_name}: {e}"))
            else:
                results.append(ToolMessage(tool_call_id=tc["id"], name=tool_name, content="Tool not found."))
                
        return {"messages": results}

    def auto_coder_skill(state: AgentState):
        last_msg = state["messages"][-1]
        missing_tools = []
        available_names = [t.name for t in state.get("available_tools", [])]
        
        for tc in last_msg.tool_calls:
            if tc["name"] not in available_names:
                missing_tools.append(tc)
                
        coder_llm = init_llm()
        
        for tc in missing_tools:
            tool_name = tc["name"]
            tool_args = tc.get("args", {})
            prompt = f"""You are an autonomous AI coding agent. The main LLM tried to use a tool named '{tool_name}' with arguments {tool_args}, but it does not exist in the system.
Your task is to write a Python Langchain @tool named '{tool_name}' that implements the expected functionality based on its name and arguments.
RULES:
1. ONLY output valid Python code. No markdown formatting, no explanations, no ```python blocks. Just the raw code.
2. Must import `from langchain_core.tools import tool`.
3. Must use `@tool` decorator.
4. Function name MUST be exactly `{tool_name}`.
5. Provide type hints and a docstring.
6. Make it safe (handle exceptions).
7. Return a string result.
"""
            code = coder_llm.invoke(prompt).content
            
            if code.startswith("```python"):
                code = code.split("```python", 1)[1]
            elif code.startswith("```"):
                code = code.split("```", 1)[1]
                
            if code.endswith("```"):
                code = code.rsplit("```", 1)[0]
            code = code.strip()
            
            base_skills_dir = os.path.join(os.path.dirname(os.path.dirname(__file__)), "skills")
            generated_skills_dir = os.path.join(base_skills_dir, "generated")
            os.makedirs(generated_skills_dir, exist_ok=True)
            
            file_path = os.path.join(generated_skills_dir, f"{tool_name}_skill.py")
            with open(file_path, "w", encoding="utf-8") as f:
                f.write(code)
                
        # Reload tools
        updated_tools = load_all_tools()
        
        tool_messages = []
        for tc in missing_tools:
            tool_messages.append(
                ToolMessage(
                    tool_call_id=tc["id"],
                    name=tc["name"],
                    content=f"SYSTEM: This tool did not exist previously, but the Cognitive OS Autonomous Coder has just written its code and loaded it! The tool is now available. Please re-evaluate and you can now use it to accomplish your task."
                )
            )
            
        return {"messages": tool_messages, "available_tools": updated_tools}

    workflow = StateGraph(AgentState)
    
    workflow.add_node("context_builder", context_builder)
    workflow.add_node("memory_retriever", memory_retriever)
    workflow.add_node("tool_search_retriever", tool_search_retriever)
    workflow.add_node("project_search", project_search)
    workflow.add_node("prompt_builder", prompt_builder)
    workflow.add_node("react_llm", react_llm)
    workflow.add_node("execute_tool", execute_tool)
    workflow.add_node("coder_skill", auto_coder_skill)
    
    workflow.add_edge(START, "context_builder")
    workflow.add_edge("context_builder", "memory_retriever")
    workflow.add_edge("memory_retriever", "tool_search_retriever")
    workflow.add_edge("tool_search_retriever", "project_search")
    workflow.add_edge("project_search", "prompt_builder")
    workflow.add_edge("prompt_builder", "react_llm")
    
    workflow.add_conditional_edges(
        "react_llm",
        route_after_llm,
        {
            "END": END,
            "coder_skill": "coder_skill",
            "execute_tool": "execute_tool"
        }
    )
    
    workflow.add_edge("execute_tool", "react_llm")
    workflow.add_edge("coder_skill", "react_llm")
    
    return workflow.compile()
