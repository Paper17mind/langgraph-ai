import os
import requests
from dotenv import load_dotenv
from langchain_core.tools import tool

load_dotenv()

@tool
def search_web(query: str, max_results: int = 5) -> str:
    """
    Searches the web for up-to-date information, news, or answers using 9Router Web Search API.
    
    Args:
        query (str): Search query.
        max_results (int): Maximum number of search results to fetch (default: 5).
    """
    load_dotenv()
    url_base = os.getenv("9ROUTER_URL", "http://localhost:20128/v1/chat/completions").replace("/chat/completions", "")
    key = os.getenv("9ROUTER_API_KEY", "")
    
    endpoint = f"{url_base}/search"
    payload = {
        "model": "ag",
        "query": query.strip(),
        "search_type": "web",
        "max_results": max_results
    }
    headers = {
        "Content-Type": "application/json",
        "Authorization": f"Bearer {key}"
    }
    
    try:
        res = requests.post(endpoint, headers=headers, json=payload, timeout=25)
        if res.status_code == 200:
            data = res.json()
            output_parts = []
            
            # If 9Router synthesized an answer, prioritize it
            if "answer" in data and isinstance(data["answer"], dict) and data["answer"].get("text"):
                output_parts.append(f"💡 Ringkasan Jawaban:\n{data['answer']['text'].strip()}")
                
            # Render individual web search results
            results = data.get("results", [])
            if results:
                items_str = []
                for idx, r in enumerate(results[:max_results], 1):
                    title = r.get("title", "No Title")
                    snippet = r.get("snippet") or r.get("content") or ""
                    url = r.get("url", "")
                    items_str.append(f"{idx}. **{title}**\n   {snippet.strip()}\n   URL: {url}")
                output_parts.append("🌐 Sumber Referensi Web:\n" + "\n\n".join(items_str))
                
            if output_parts:
                return "\n\n".join(output_parts)
            return f"No results found for query: '{query}'"
        else:
            return f"❌ 9Router Search Error (Status {res.status_code}): {res.text[:200]}"
    except Exception as e:
        return f"❌ Search error: {e}"
