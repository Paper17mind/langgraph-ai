<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ model.name }} — {{ project_name }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script src="_components.js"></script>
    <style>[x-cloak]{display:none!important}</style>
</head>
{% set fk_cols = model.fk_columns %}
{% set fk_js = [] %}
{% for fk in fk_cols %}{% set _ = fk_js.append('{ col: "' + fk.col.name + '", api: "' + fk.api + '" }') %}{% endfor %}
<body class="bg-gray-50 h-full font-sans"
      x-data="crudPage('{{ model.api_path }}', [{{ fk_js | join(', ') }}])"
      x-init="$store.toast || Alpine.store('toast', toastStore()); init()">

    <div class="flex min-h-screen">

        <!-- ── Sidebar ────────────────────────────────────────────── -->
        <aside class="w-64 shrink-0 bg-white border-r border-gray-200 flex flex-col">
            <div class="px-6 py-5 border-b border-gray-100">
                <h1 class="text-xl font-bold text-gray-900">{{ project_name }}</h1>
                <p class="text-xs text-gray-400 mt-0.5">Admin Panel</p>
            </div>
            <nav class="flex-1 py-4 space-y-0.5 px-3 overflow-y-auto">
                <a href="index.html"
                   class="flex items-center gap-3 py-2 px-3 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                    Home
                </a>
                {% for m in models %}
                <a href="{{ m.api_path }}.html"
                   class="flex items-center gap-3 py-2 px-3 rounded-lg text-sm font-medium transition-colors
                          {{ 'bg-blue-50 text-blue-700' if m.name == model.name else 'text-gray-600 hover:bg-gray-100 hover:text-gray-900' }}">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
                    {{ m.name }}
                </a>
                {% endfor %}
            </nav>
        </aside>

        <!-- ── Page content ──────────────────────────────────────── -->
        <div class="flex-1 flex flex-col">

            <!-- Topbar -->
            <header class="bg-white border-b border-gray-200 px-8 py-4 flex items-center justify-between">
                <div>
                    <h2 class="text-lg font-semibold text-gray-800">{{ model.name }}</h2>
                    <p class="text-xs text-gray-400">/api/{{ model.api_path }}</p>
                </div>
                <button @click="openModal()"
                        class="inline-flex items-center gap-2 bg-blue-600 text-white text-sm font-medium px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                    Add New
                </button>
            </header>

            <!-- Main -->
            <main class="flex-1 p-8">

                <!-- Search -->
                <div class="mb-4">
                    <div class="relative w-72">
                        <input type="text" x-model="search"
                               @input.debounce.500ms="page=1; fetchData()"
                               placeholder="Search {{ model.name }}…"
                               class="w-full pl-9 pr-4 py-2 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition">
                        <svg class="w-4 h-4 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </div>
                </div>

                <!-- Table -->
                <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm">
                            <thead>
                                <tr class="bg-gray-50 border-b border-gray-100 text-xs text-gray-500 uppercase tracking-wider">
                                    {% for col in model.columns %}
                                    <th class="px-5 py-3 font-semibold">{{ col.name }}</th>
                                    {% endfor %}
                                    <th class="px-5 py-3 font-semibold text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-50">
                                <template x-for="item in items" :key="item.id">
                                    <tr class="hover:bg-blue-50/30 transition-colors group">
                                        {% for col in model.columns %}
                                        <td class="px-5 py-3.5 text-gray-700 text-sm max-w-[200px] truncate"
                                            x-text="item.{{ col.name }}"></td>
                                        {% endfor %}
                                        <td class="px-5 py-3.5 text-right whitespace-nowrap">
                                            <button @click="openModal(item)"
                                                    class="text-indigo-600 hover:text-indigo-800 font-medium text-xs mr-3 opacity-0 group-hover:opacity-100 transition-opacity">
                                                Edit
                                            </button>
                                            <button @click="deleteItem(item.id)"
                                                    class="text-red-500 hover:text-red-700 font-medium text-xs opacity-0 group-hover:opacity-100 transition-opacity">
                                                Delete
                                            </button>
                                        </td>
                                    </tr>
                                </template>
                                <tr x-show="items.length === 0">
                                    <td colspan="100%"
                                        class="py-12 text-center text-gray-400 text-sm">
                                        No records found
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="px-5 py-3 border-t border-gray-100 flex items-center justify-between text-xs text-gray-500 bg-gray-50/50">
                        <span>Page <b x-text="page" class="text-gray-700"></b> of <b x-text="totalPages" class="text-gray-700"></b></span>
                        <div class="flex gap-2">
                            <button @click="prevPage()" :disabled="page <= 1"
                                    class="px-3 py-1.5 border border-gray-200 rounded-md bg-white hover:bg-gray-50 disabled:opacity-40 disabled:cursor-not-allowed transition-colors">
                                ← Prev
                            </button>
                            <button @click="nextPage()" :disabled="page >= totalPages"
                                    class="px-3 py-1.5 border border-gray-200 rounded-md bg-white hover:bg-gray-50 disabled:opacity-40 disabled:cursor-not-allowed transition-colors">
                                Next →
                            </button>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- ── Modal ───────────────────────────────────────────────────── -->
    <div x-show="isModalOpen" x-cloak
         class="fixed inset-0 z-50 flex items-center justify-center">

        <!-- Backdrop -->
        <div class="absolute inset-0 bg-gray-900/40 backdrop-blur-sm"
             x-transition.opacity
             @click="isModalOpen = false">
        </div>

        <!-- Dialog -->
        <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-lg mx-4 overflow-hidden z-10"
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 scale-95"
             x-transition:enter-end="opacity-100 scale-100"
             x-transition:leave="transition ease-in duration-150"
             x-transition:leave-start="opacity-100 scale-100"
             x-transition:leave-end="opacity-0 scale-95">

            <!-- Header -->
            <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
                <h3 class="text-base font-semibold text-gray-800"
                    x-text="editingId ? 'Edit {{ model.name }}' : 'New {{ model.name }}'">
                </h3>
                <button @click="isModalOpen = false"
                        class="text-gray-400 hover:text-gray-600 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <!-- Body / Form -->
            <div class="p-6 max-h-[75vh] overflow-y-auto">
                <form @submit.prevent="saveItem()" class="space-y-4">

                    {% for col in model.columns %}
                    {% if not col.primary and not col.autoIncrement %}

                    {% set ns = namespace(is_fk=false, fk_api='', fk_col='') %}
                    {% for fk in fk_cols %}
                    {% if fk.col.name == col.name %}{% set ns.is_fk = true %}{% set ns.fk_api = fk.api %}{% set ns.fk_col = fk.col.name %}{% endif %}
                    {% endfor %}

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                            {{ col.name }}
                            {% if col.nullable is defined and col.nullable == false %}<span class="text-red-500 ml-0.5">*</span>{% endif %}
                        </label>

                        {% if ns.is_fk %}
                        <!-- FK dropdown: fetched from /api/{{ ns.fk_api }} -->
                        <select x-model="form.{{ col.name }}"
                                class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition bg-white"
                                {% if col.nullable is defined and col.nullable == false %}required{% endif %}>
                            <option value="">— Select {{ ns.fk_api }} —</option>
                            <template x-for="opt in (fkOptions['{{ col.name }}'] || [])" :key="opt.value">
                                <option :value="opt.value"
                                        :selected="form.{{ col.name }} == opt.value"
                                        x-text="opt.label">
                                </option>
                            </template>
                        </select>

                        {% elif col.type == 'boolean' %}
                        <select x-model="form.{{ col.name }}"
                                class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition bg-white">
                            <option value="">— Select —</option>
                            <option value="1">Yes</option>
                            <option value="0">No</option>
                        </select>

                        {% elif col.type in ['text', 'json'] %}
                        <textarea rows="3" x-model="form.{{ col.name }}"
                                  class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition resize-none"
                                  {% if col.nullable is defined and col.nullable == false %}required{% endif %}></textarea>

                        {% elif col.type in ['date', 'datetime'] %}
                        <input type="{{ 'datetime-local' if col.type == 'datetime' else 'date' }}"
                               x-model="form.{{ col.name }}"
                               class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
                               {% if col.nullable is defined and col.nullable == false %}required{% endif %}>

                        {% elif col.type in ['integer', 'bigInteger', 'decimal', 'float'] %}
                        <input type="number" x-model="form.{{ col.name }}"
                               class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
                               {% if col.type in ['decimal', 'float'] %}step="0.01"{% endif %}
                               {% if col.nullable is defined and col.nullable == false %}required{% endif %}>

                        {% else %}
                        <input type="text" x-model="form.{{ col.name }}"
                               class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition"
                               {% if col.nullable is defined and col.nullable == false %}required{% endif %}>
                        {% endif %}
                    </div>

                    {% endif %}
                    {% endfor %}

                    <!-- Actions -->
                    <div class="pt-4 flex justify-end gap-3 border-t border-gray-100">
                        <button type="button" @click="isModalOpen = false"
                                class="px-4 py-2 text-sm border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors font-medium">
                            Cancel
                        </button>
                        <button type="submit" :disabled="isSaving"
                                class="px-5 py-2 text-sm bg-blue-600 text-white rounded-lg hover:bg-blue-700 disabled:opacity-60 transition-colors font-medium shadow-sm flex items-center gap-2">
                            <svg x-show="isSaving" class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
                            <span x-text="isSaving ? 'Saving…' : (editingId ? 'Update' : 'Create')"></span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ── Toast ────────────────────────────────────────────────────── -->
    <div class="fixed bottom-5 right-5 z-[999] space-y-2" x-cloak>
        <template x-for="t in $store.toast.toasts" :key="t.id">
            <div x-transition
                 :class="t.type === 'error' ? 'bg-red-600' : 'bg-emerald-600'"
                 class="text-white text-sm px-4 py-3 rounded-xl shadow-lg flex items-center gap-3 min-w-[220px]">
                <span x-text="t.msg" class="flex-1"></span>
                <button @click="$store.toast.dismiss(t.id)" class="opacity-70 hover:opacity-100 text-lg leading-none">✕</button>
            </div>
        </template>
    </div>

</body>
</html>
