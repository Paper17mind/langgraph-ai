<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ model.name }} Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="bg-gray-100 flex min-h-screen font-sans">
    <!-- Sidebar -->
    <aside class="w-64 bg-white shadow-md z-10">
        <div class="p-6">
            <h1 class="text-2xl font-bold text-gray-800">Dashboard</h1>
        </div>
        <nav class="mt-6">
            <a href="index.html" class="block py-3 px-6 text-gray-600 hover:bg-gray-50 transition-colors">Home</a>
            {% for m in models %}
            <a href="{{ to_kebab(m.name) }}.html" class="block py-3 px-6 {% if m.name == model.name %}bg-blue-50 text-blue-700 font-semibold border-r-4 border-blue-600{% else %}text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors{% endif %}">{{ m.name }}</a>
            {% endfor %}
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 p-8" x-data="crudData()">
        <div class="flex justify-between items-center mb-8">
            <h2 class="text-3xl font-bold text-gray-800">{{ model.name }} Management</h2>
            <button @click="openModal()" class="bg-blue-600 text-white px-5 py-2.5 rounded-lg shadow-sm hover:bg-blue-700 transition-colors font-medium flex items-center">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                Add New
            </button>
        </div>

        <!-- Filter & Table -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="p-5 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
                <div class="relative w-72">
                    <input type="text" x-model="search" @input.debounce.500ms="fetchData()" placeholder="Search..." class="pl-10 pr-4 py-2 border border-gray-300 rounded-lg w-full focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-shadow">
                    <svg class="w-5 h-5 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </div>
            </div>
            
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50/50 text-gray-500 text-xs uppercase tracking-wider">
                            {% for col in model.columns %}
                            <th class="border-b py-4 px-6 font-semibold">{{ col.name }}</th>
                            {% endfor %}
                            <th class="border-b py-4 px-6 font-semibold text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        <template x-for="item in items" :key="item.id">
                            <tr class="hover:bg-blue-50/50 transition-colors group">
                                {% for col in model.columns %}
                                <td class="py-4 px-6 text-gray-700 text-sm" x-text="item.{{ col.name }}"></td>
                                {% endfor %}
                                <td class="py-4 px-6 text-right">
                                    <button @click="openModal(item)" class="text-indigo-600 hover:text-indigo-900 font-medium mr-3 opacity-0 group-hover:opacity-100 transition-opacity">Edit</button>
                                    <button @click="deleteItem(item.id)" class="text-red-600 hover:text-red-900 font-medium opacity-0 group-hover:opacity-100 transition-opacity">Delete</button>
                                </td>
                            </tr>
                        </template>
                        <tr x-show="items.length === 0">
                            <td colspan="100%" class="py-8 text-center text-gray-500">No data found</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="p-4 border-t border-gray-100 flex justify-between items-center bg-gray-50/50 text-sm">
                <div class="text-gray-600">
                    Showing page <span class="font-semibold text-gray-900" x-text="page"></span> of <span class="font-semibold text-gray-900" x-text="totalPages"></span>
                </div>
                <div class="flex space-x-2">
                    <button @click="prevPage()" :disabled="page <= 1" class="px-3 py-1.5 border border-gray-300 rounded-md bg-white text-gray-700 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">Previous</button>
                    <button @click="nextPage()" :disabled="page >= totalPages" class="px-3 py-1.5 border border-gray-300 rounded-md bg-white text-gray-700 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">Next</button>
                </div>
            </div>
        </div>

        <!-- Modal Dialog -->
        <div x-show="isModalOpen" style="display: none;" class="fixed inset-0 z-50 flex items-center justify-center" x-cloak>
            <div class="absolute inset-0 bg-gray-900/40 backdrop-blur-sm" x-show="isModalOpen" x-transition.opacity @click="isModalOpen = false"></div>
            
            <div class="bg-white rounded-xl shadow-2xl w-full max-w-lg relative z-10 overflow-hidden" 
                 x-show="isModalOpen" 
                 x-transition:enter="transition ease-out duration-300"
                 x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
                 x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
                 x-transition:leave="transition ease-in duration-200"
                 x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
                 x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95">
                
                <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
                    <h3 class="text-xl font-bold text-gray-800" x-text="editingId ? 'Edit {{ model.name }}' : 'Create New {{ model.name }}'"></h3>
                    <button @click="isModalOpen = false" class="text-gray-400 hover:text-gray-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>
                
                <div class="p-6">
                    <form @submit.prevent="saveItem()">
                        <div class="space-y-4">
                            {% for col in model.columns %}
                            {% if not col.primary and not col.autoIncrement %}
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">{{ col.name }}</label>
                                <input type="text" x-model="form.{{ col.name }}" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-shadow" required>
                            </div>
                            {% endif %}
                            {% endfor %}
                        </div>
                        
                        <div class="mt-8 flex justify-end space-x-3">
                            <button type="button" @click="isModalOpen = false" class="px-5 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors font-medium">Cancel</button>
                            <button type="submit" class="px-5 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium shadow-sm flex items-center">
                                <span x-show="!isSaving">Save Changes</span>
                                <span x-show="isSaving">Saving...</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <script>
        function crudData() {
            return {
                items: [],
                search: '',
                page: 1,
                limit: 10,
                totalPages: 1,
                isModalOpen: false,
                isSaving: false,
                editingId: null,
                form: {},
                
                async fetchData() {
                    try {
                        const res = await fetch(`/api/{{ to_kebab(model.name) }}?page=${this.page}&limit=${this.limit}&search=${this.search}`);
                        const json = await res.json();
                        this.items = json.data || json;
                        if (json.total_pages) {
                            this.totalPages = json.total_pages;
                        }
                    } catch (e) {
                        console.error("Fetch error", e);
                    }
                },
                
                async saveItem() {
                    this.isSaving = true;
                    const method = this.editingId ? 'PUT' : 'POST';
                    const url = this.editingId ? `/api/{{ to_kebab(model.name) }}/${this.editingId}` : `/api/{{ to_kebab(model.name) }}`;
                    try {
                        await fetch(url, {
                            method,
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(this.form)
                        });
                        this.isModalOpen = false;
                        this.fetchData();
                    } catch (e) {
                        alert("Error saving data");
                    } finally {
                        this.isSaving = false;
                    }
                },
                
                async deleteItem(id) {
                    if (!confirm("Are you sure you want to delete this record? This action cannot be undone.")) return;
                    try {
                        await fetch(`/api/{{ to_kebab(model.name) }}/${id}`, { method: 'DELETE' });
                        this.fetchData();
                    } catch (e) {
                        alert("Error deleting data");
                    }
                },
                
                openModal(item = null) {
                    if (item) {
                        this.editingId = item.id;
                        this.form = JSON.parse(JSON.stringify(item));
                    } else {
                        this.editingId = null;
                        this.form = {};
                    }
                    this.isModalOpen = true;
                },
                
                nextPage() {
                    if (this.page < this.totalPages) {
                        this.page++;
                        this.fetchData();
                    }
                },
                
                prevPage() {
                    if (this.page > 1) {
                        this.page--;
                        this.fetchData();
                    }
                },
                
                init() {
                    this.fetchData();
                }
            }
        }
    </script>
    <style>
        [x-cloak] { display: none !important; }
    </style>
</body>
</html>
