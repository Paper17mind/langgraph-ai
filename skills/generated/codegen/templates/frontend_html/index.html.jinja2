<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="bg-gray-100 flex min-h-screen font-sans">
    <aside class="w-64 bg-white shadow-md">
        <div class="p-6">
            <h1 class="text-2xl font-bold text-gray-800">Dashboard</h1>
        </div>
        <nav class="mt-6">
            <a href="index.html" class="block py-3 px-6 bg-blue-50 text-blue-700 font-semibold border-r-4 border-blue-600">Home</a>
            {% for model in models %}
            <a href="{{ to_kebab(model.name) }}.html" class="block py-3 px-6 text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors">{{ model.name }}</a>
            {% endfor %}
        </nav>
    </aside>
    <main class="flex-1 p-8">
        <h2 class="text-3xl font-bold text-gray-800 mb-6">Welcome to Dashboard</h2>
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
            <p class="text-gray-600">Select a menu from the sidebar to manage data.</p>
        </div>
    </main>
</body>
</html>
